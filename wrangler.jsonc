{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rabble-scribble",
  "compatibility_date": "2026-05-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "scribble.joinrabble.world", "custom_domain": true }
  ]
}
